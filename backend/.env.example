ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
CLAUDE_MODEL=claude-haiku-4-5
FRONTEND_ORIGIN=http://localhost:3000

# Session pooler URI from Supabase, used to apply migrations
DATABASE_URL=

# run_python runs in a Docker container with no network or host filesystem access.
# It is offered only when Docker is available and its image can be prepared.
# Set ENABLE_CODE_EXECUTION=false to turn it off.
ENABLE_CODE_EXECUTION=true
