ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
CLAUDE_MODEL=claude-haiku-4-5
FRONTEND_ORIGIN=http://localhost:3000

# Optional daily live message limits, reset at midnight UTC. Unset means disabled.
# DAILY_MESSAGES_PER_VISITOR=10
# DAILY_MESSAGES_PER_IP=20
# DAILY_MESSAGES_TOTAL=30
# MAX_MESSAGE_CHARS=2000
# TRUST_PROXY=false

# Session pooler URI from Supabase, used to apply migrations
DATABASE_URL=

# run_python runs in a Docker container with no network or host filesystem access.
# It is offered only when Docker is available and its image can be prepared.
# Set ENABLE_CODE_EXECUTION=false to turn it off.
ENABLE_CODE_EXECUTION=true
