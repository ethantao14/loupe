# Copy to /etc/loupe/backend.env on the server. Never commit the real file.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# The deployed frontend's origin, for CORS, e.g. https://loupe-demo.vercel.app
FRONTEND_ORIGIN=
ENABLE_CODE_EXECUTION=true
# Caddy on the same machine appends the client address.
TRUST_PROXY=true
DAILY_MESSAGES_PER_VISITOR=15
DAILY_MESSAGES_PER_IP=30
DAILY_MESSAGES_TOTAL=30
