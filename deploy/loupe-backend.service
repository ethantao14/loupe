[Unit]
Description=Loupe backend
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=loupe
Group=loupe
WorkingDirectory=/opt/loupe/backend
EnvironmentFile=/etc/loupe/backend.env
ExecStart=/opt/loupe/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
